{
  "name": "exicon-to-csv",
  "version": "1.0.0",
  "description": "Convert exicon data to CSV format",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc && cpy 'src/*.json' dist/",
    "clean": "rm -rf dist",
    "test": "node --test dist/**/*.test.js",
    "typecheck": "tsc --noEmit",
    "fetch": "tsx src/scripts/fetch-exicon-script.ts",
    "no-tags": "tsx src/scripts/no-tags-script.ts",
    "tags": "tsx src/scripts/get-unique-tags-script.ts"
  },
  "dependencies": {
    "json-2-csv": "catalog:"
  },
  "devDependencies": {
    "@tsconfig/node24": "catalog:",
    "@types/node": "catalog:",
    "cpy-cli": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}

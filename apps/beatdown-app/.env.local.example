# Database — matches Docker Compose defaults
DATABASE_URL=postgres://postgres:postgres@localhost:5432/beatdown

# Firebase (Client SDK) — from Firebase Console > Project Settings > Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Firebase Admin SDK — from Firebase Console > Project Settings > Service accounts
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Resend — from https://resend.com/api-keys
RESEND_API_KEY=

# Anthropic Claude — from https://console.anthropic.com/keys
ANTHROPIC_API_KEY=

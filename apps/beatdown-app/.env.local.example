# Database — Neon PostgreSQL connection string (from https://console.neon.tech)
# Direct connection (use for migrations and local dev):
DATABASE_URL=postgresql://user:password@ep-<id>.<region>.aws.neon.tech/<dbname>?sslmode=require
# Pooled connection (recommended for serverless/Vercel deployments — add -pooler to the hostname):
# DATABASE_URL=postgresql://user:password@ep-<id>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require

# Better Auth — secret and base URL
BETTER_AUTH_SECRET= # openssl rand -base64 32
BETTER_AUTH_URL= # http://localhost:3000 (dev) / https://your-domain.com (prod)

# Resend — from https://resend.com/api-keys
RESEND_API_KEY=

# Anthropic Claude — from https://console.anthropic.com/keys
ANTHROPIC_API_KEY=

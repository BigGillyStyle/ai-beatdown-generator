{
  "name": "ai-beatdown-generator",
  "version": "1.0.0",
  "description": "PNPM workspace for AI beatdown generation tools",
  "private": true,
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=10.33.0"
  },
  "packageManager": "pnpm@10.34.8+sha512.f627a8e971343afe49dfd0f63d028234201dfa831d5cb588733e1e5f8db26bf16989a32161ab5c1b4db3b1fdbc373160606b5b89e002df6dd19a85adf91fc5a8",
  "scripts": {
